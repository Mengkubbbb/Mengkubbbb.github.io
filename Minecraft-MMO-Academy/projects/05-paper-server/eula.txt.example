# eula.txt.example — ตัวอย่างไฟล์ยอมรับ EULA
#
# ⚠️ ห้ามคัดลอกไฟล์นี้ไปใช้โดยไม่อ่านข้อตกลงจริงก่อน
#    อ่านได้ที่ https://aka.ms/MinecraftEULA
#
# ขั้นตอนที่ถูกต้อง:
#   1) เปิดลิงก์ข้างบนและอ่าน (อย่างน้อยหัวข้อที่เกี่ยวกับการให้บริการผู้อื่น)
#   2) ถ้ายอมรับข้อตกลง ให้สร้างไฟล์ eula.txt ในโฟลเดอร์เซิร์ฟเวอร์ ที่มีเนื้อหา:
#
#         eula=true
#
#   3) ถ้าไม่ยอมรับ ให้ลบเซิร์ฟเวอร์ทิ้ง (เซิร์ฟเวอร์จะปิดตัวเองถ้า eula ไม่ใช่ true)
#
# เหตุผลที่ต้องมีการยอมรับ: Mojang กำหนดให้ผู้ให้บริการเซิร์ฟเวอร์ยอมรับข้อตกลง
# และการเปิดเซิร์ฟเวอร์เชิงพาณิชย์มีข้อกำหนดเพิ่มเติม (ดู business/launch-checklist.md)
eula=false
